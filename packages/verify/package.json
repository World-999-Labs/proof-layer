{
  "name": "@proof-layer/verify",
  "version": "1.0.1",
  "description": "Standalone offline verifier for Proof Layer receipt bundles. Ed25519 signature verification, SHA-256 hash chain validation, and Merkle root computation. Zero external dependencies.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "homepage": "https://prooflayer.world999labs.com",
  "bugs": { "url": "https://github.com/World-999-Labs/proof-layer/issues" },
  "repository": {
    "type": "git",
    "url": "https://github.com/World-999-Labs/proof-layer.git",
    "directory": "packages/verify"
  },
  "keywords": [
    "proof-layer",
    "prooflayer",
    "world999labs",
    "governance",
    "receipts",
    "verification",
    "audit",
    "ed25519",
    "sha-256",
    "hash-chain",
    "merkle",
    "offline",
    "zero-dependencies"
  ]
}
